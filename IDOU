const kBrand = Color(0xFF0E7490); // couleur principale (bleu pétrole)
const kBrandDark = Color(0xFF0B1F3A); // bleu nuit (dégradé)
const kBlocked = Color(0xFFE5484D); // rouge  = bloqué
const kAllowed = Color(0xFF30A46C); // vert   = autorisé
const kPending = Color(0xFFF5A524); // orange = à valider

Color alpha(Color c, double o) => c.withAlpha((o * 255).round());

// ------------------------------------------------------------
// 2. MODÈLE DE DONNÉES (simulé)
// ------------------------------------------------------------
enum Verdict { blocked, allowed, pending }

Color verdictColor(Verdict v) => v == Verdict.blocked
    ? kBlocked
    : v == Verdict.allowed
    ? kAllowed
    : kPending;

IconData verdictIcon(Verdict v) => v == Verdict.blocked
    ? Icons.gpp_bad_rounded
    : v == Verdict.allowed
    ? Icons.verified_user_rounded
    : Icons.help_center_rounded;

String verdictLabel(Verdict v) => v == Verdict.blocked
    ? 'Bloquée'
    : v == Verdict.allowed
    ? 'Autorisée'
    : 'À valider';

class Decision {
  final String ip, domain, time, reason;
  final int confidence;
  Verdict verdict;
  bool trusted;
  Decision(
    this.ip,
    this.domain,
    this.time,
    this.verdict,
    this.confidence,
    this.reason, {
    this.trusted = false,
  });
}

