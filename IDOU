  Widget _chart() {
    const days = ['Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam', 'Dim'];
    const ok = [40, 52, 38, 61, 47, 30, 44];
    const bl = [22, 30, 18, 41, 27, 15, 26];
    const pe = [3, 5, 2, 6, 4, 1, 3];
    const maxTotal = 110.0;
    const maxH = 130.0;

    Widget seg(int v, Color c) =>
        Container(width: 22, height: v / maxTotal * maxH, color: c);

    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        const SectionTitle(Icons.bar_chart_rounded, 'Activité sur 7 jours'),
        SizedBox(
          height: maxH + 24,
          child: Row(
            mainAxisAlignment: MainAxisAlignment.spaceAround,
            crossAxisAlignment: CrossAxisAlignment.end,
            children: [
              for (int i = 0; i < 7; i++)
                Column(
                  mainAxisAlignment: MainAxisAlignment.end,
                  children: [
                    ClipRRect(
                      borderRadius: BorderRadius.circular(6),
                      child: Column(
                        children: [
                          seg(pe[i], kPending),
                          seg(bl[i], kBlocked),
                          seg(ok[i], kAllowed),
                        ],
                      ),
                    ),
                    const SizedBox(height: 6),
                    Text(days[i], style: const TextStyle(fontSize: 11)),
