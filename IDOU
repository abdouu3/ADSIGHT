  Widget _switch(
    IconData icon,
    String label,
    bool value,
    void Function(bool) set,
  ) {
    return SwitchListTile(
      contentPadding: EdgeInsets.zero,
      secondary: Icon(icon, color: kBrand),
      title: Text(label),
      value: value,
      onChanged: (v) => setState(() => set(v)),
    );
  }
}

// ------------------------------------------------------------
// 6. ÉCRAN 2 : DÉTAIL D'UNE ANALYSE
// ------------------------------------------------------------
class DetailPage extends StatelessWidget {
  final Decision d;
  final void Function(Verdict, bool) onDecide;
  const DetailPage({super.key, required this.d, required this.onDecide});

  void _act(BuildContext context, Verdict v, bool trust, String msg) {
    onDecide(v, trust);
    Navigator.of(context).pop();
    ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(msg)));
  }

  @override
  Widget build(BuildContext context) {
    final c = verdictColor(d.verdict);
    final isDark = Theme.of(context).brightness == Brightness.dark;

    final image = Container(
      height: 220,
      width: double.infinity,
      decoration: BoxDecoration(
        color: isDark ? const Color(0xFF1B2640) : const Color(0xFFE9EEF5),
        borderRadius: BorderRadius.circular(20),
      ),
      child: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          Icon(Icons.image_search_rounded, size: 56, color: alpha(kBrand, .8)),
          const SizedBox(height: 8),
          const Text(
            'Capture analysée',
            style: TextStyle(fontWeight: FontWeight.w700),
          ),
          Text(d.domain, style: const TextStyle(fontSize: 12)),
        ],
      ),
    );

    final verdictPanel = Panel(
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(
                      d.ip,
                      style: const TextStyle(
                        fontSize: 18,
                        fontWeight: FontWeight.w800,
                        fontFamily: 'monospace',
                      ),
                    ),
                    const SizedBox(height: 6),
                    StatusChip(d.verdict),
                  ],
                ),
              ),
              SizedBox(
                width: 84,
                height: 84,
                child: Stack(
                  alignment: Alignment.center,
                  children: [
                    SizedBox(
                      width: 84,
                      height: 84,
                      child: CircularProgressIndicator(
                        value: d.confidence / 100,
                        strokeWidth: 9,
                        color: c,
                        backgroundColor: alpha(c, .15),
                      ),
                    ),
                    Column(
                      mainAxisSize: MainAxisSize.min,
                      children: [
                        Text(
                          '${d.confidence}%',
                          style: const TextStyle(
                            fontSize: 18,
                            fontWeight: FontWeight.w800,
                          ),
                        ),
                        const Text('confiance', style: TextStyle(fontSize: 10)),
                      ],
                    ),
                  ],
                ),
              ),
            ],
          ),
          const Divider(height: 28),
          Row(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              const Icon(Icons.psychology_alt_rounded, color: kBrand),
              const SizedBox(width: 10),
              Expanded(
                child: Text(d.reason, style: const TextStyle(height: 1.4)),
              ),
            ],
          ),
        ],
      ),
    );

    final buttons = Column(
      children: [
        SizedBox(
          width: double.infinity,
          child: FilledButton.icon(
            style: FilledButton.styleFrom(
              backgroundColor: kBlocked,
              padding: const EdgeInsets.all(16),
            ),
            icon: const Icon(Icons.block_rounded),
            label: const Text('Confirmer le blocage'),
            onPressed: () => _act(
              context,
              Verdict.blocked,
              false,
              '${d.ip} ajoutée à la liste noire',
            ),
          ),
        ),
        const SizedBox(height: 10),
        SizedBox(
          width: double.infinity,
          child: FilledButton.icon(
            style: FilledButton.styleFrom(
              backgroundColor: kAllowed,
              padding: const EdgeInsets.all(16),
            ),
            icon: const Icon(Icons.check_circle_rounded),
            label: const Text('Autoriser'),
            onPressed: () =>
                _act(context, Verdict.allowed, false, '${d.ip} autorisée'),
          ),
        ),
        const SizedBox(height: 10),
        SizedBox(
          width: double.infinity,
          child: OutlinedButton.icon(
            style: OutlinedButton.styleFrom(padding: const EdgeInsets.all(16)),
            icon: const Icon(Icons.verified_user_rounded),
            label: const Text('Toujours autoriser ce site'),
            onPressed: () => _act(
              context,
              Verdict.allowed,
              true,
              '${d.domain} ajouté à la liste blanche',
            ),
          ),
        ),
      ],
    );

    return Scaffold(
      appBar: AppBar(title: const Text('Détail de l\'analyse')),
      body: LayoutBuilder(
        builder: (context, box) {
          final wide = box.maxWidth > 700;
          return ListView(
            padding: const EdgeInsets.fromLTRB(16, 4, 16, 24),
            children: [
              if (wide)
                Row(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Expanded(child: image),
                    const SizedBox(width: 16),
                    Expanded(child: verdictPanel),
                  ],
                )
              else ...[
                image,
                const SizedBox(height: 14),
                verdictPanel,
              ],
              const SizedBox(height: 16),
              buttons,
            ],
          );
        },
      ),
    );
  }
}
