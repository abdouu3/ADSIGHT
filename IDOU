  int count(Verdict v) => decisions.where((d) => d.verdict == v).length;

  void open(Decision d) {
    Navigator.of(context).push(
      MaterialPageRoute(
        builder: (_) => DetailPage(
          d: d,
          onDecide: (v, trust) => setState(() {
            d.verdict = v;
            d.trusted = trust;
